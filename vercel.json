{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/projects",
      "destination": "/#work",
      "permanent": false
    },
    {
      "source": "/project/klaus",
      "destination": "/project/3d-art",
      "permanent": true
    },
    {
      "source": "/project/tiny-tavern",
      "destination": "/project/3d-art",
      "permanent": true
    }
  ]
}
